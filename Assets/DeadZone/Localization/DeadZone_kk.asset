  m_TableData:
  - m_Id: 2189381632
    m_Localized: "\u0411\u0435\u0441 \u0442\u043E\u043B\u049B\u044B\u043D. \u0411\u0435\u0441 \u0431\u043E\u0441\u0441. \u0410\u043C\u0430\u043D \u0448\u044B\u0493\u0443\u0493\u0430 \u0431\u0456\u0440 \u043C\u04AF\u043C\u043A\u0456\u043D\u0434\u0456\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 2365542400
    m_Localized: "\u041A\u0415\u0419\u0406\u041F\u041A\u0415\u0420\u0414\u0406 \u0422\u0410\u04A2\u0414\u0410  /  03"
