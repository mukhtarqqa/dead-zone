  - m_Id: 2378125326
    m_Localized: "<color=#F16E7A>\u0416\u0415\u04A2\u0406\u041B\u0406\u0421</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125327
    m_Localized: "\u0423\u0430\u049B\u044B\u0442: {0:00}:{1:00}"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125328
    m_Localized: "Enter \u2014 \u049B\u0430\u0439\u0442\u0430 \u0431\u0430\u0441\u0442\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125329
    m_Localized: "{0} \xB7 \u0416\u043E\u0439\u0493\u0430\u043D\u044B {1} \xB7 \u0417\u0430\u043B\u0430\u043B {2} \xB7 \u0422\u04B1\u0440\u0493\u044B\u0437\u0493\u0430\u043D\u044B {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125330
    m_Localized: "\u0420\u0415\u041C \xB7 \u041E\u041D\u0418 {0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125331
    m_Localized: "\u049A\u0410\u0411\u0406\u041B\u0415\u0422 \u0414\u0410\u0419\u042B\u041D\u0414\u0410\u041B\u0423\u0414\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125332
    m_Localized: "Q \xB7 \u049A\u0410\u0411\u0406\u041B\u0415\u0422 \u0414\u0410\u0419\u042B\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125333
    m_Localized: "Q \xB7 \u049A\u0423\u0410\u0422 {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125334
    m_Localized: "\u0422\u0430\u043F\u0430\u043D\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125335
    m_Localized: "\u041F\u0443\u043B\u0435\u043C\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125336
    m_Localized: "\u0411\u044B\u0442\u044B\u0440\u0430\u043B\u044B \u043C\u044B\u043B\u0442\u044B\u049B"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125337
    m_Localized: "\u041C\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125338
    m_Localized: "\u049A\u043E\u0440: \u043E\u049B-\u0434\u04D9\u0440\u0456 \u0436\u04D9\u043D\u0435 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125339
    m_Localized: "\u0410\u04A3\u0448\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125340
    m_Localized: "\u041C\u0435\u0440\u0433\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125341
    m_Localized: "\u049A\u0438\u0440\u0430\u0442\u0443\u0448\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125342
    m_Localized: "\u0428\u0430\u049B\u044B\u0440\u0443\u0448\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125343
    m_Localized: "\u0410\u0439\u043C\u0430\u049B \u0441\u0430\u049B\u0448\u044B\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125344
    m_Localized: "\u0411\u0410\u0419\u041B\u0410\u041D\u042B\u0421 \u0416\u041E\u049A"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125345
    m_Localized: "\u0411\u0410\u049A\u042B\u041B\u0410\u041F \u041E\u0422\u042B\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125346
    m_Localized: "\u0422\u04B0\u0420\u0492\u042B\u0417\u0423 \xB7 {0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125347
    m_Localized: "\u0421\u0422\u0410\u0422\u0418\u0421\u0422\u0418\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125348
    m_Localized: "\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125349
    m_Localized: "\u041C\u0430\u0442\u0447\u0442\u0430\u0440: {0}\n\u0416\u0435\u04A3\u0456\u0441\u0442\u0435\u0440: {1}\n\u0416\u043E\u0439\u044B\u043B\u0493\u0430\u043D \u0436\u0430\u0443\u043B\u0430\u0440: {2}\n\u041A\u0435\u043B\u0442\u0456\u0440\u0456\u043B\u0433\u0435\u043D \u0437\u0430\u043B\u0430\u043B: {3}\n\u0422\u04B1\u0440\u0493\u044B\u0437\u044B\u043B\u0493\u0430\u043D \u043E\u0434\u0430\u049B\u0442\u0430\u0441\u0442\u0430\u0440: {4}\n\u041E\u0439\u044B\u043D\u0434\u0430\u0493\u044B \u0443\u0430\u049B\u044B\u0442: {5} \u043C\u0438\u043D\n\u04AE\u0437\u0434\u0456\u043A \u04E9\u0442\u0443 \u0443\u0430\u049B\u044B\u0442\u044B: {6}"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125350
    m_Localized: "\u0410\u0440\u0442\u049B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125351
    m_Localized: "DEAD ZONE <color=#74E5D0>/ \u0422\u041E\u041F</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125352
    m_Localized: "\u0411\u0456\u0440 \u043E\u0439\u044B\u043D\u0448\u044B \u0431\u04E9\u043B\u043C\u0435 \u0430\u0448\u0430\u0434\u044B, \u049B\u0430\u043B\u0493\u0430\u043D\u0434\u0430\u0440\u044B \u049B\u043E\u0441\u044B\u043B\u0430\u0434\u044B. \u04D8\u0440\u043A\u0456\u043C \u04E9\u0437 \u043A\u0435\u0439\u0456\u043F\u043A\u0435\u0440\u0456\u043C\u0435\u043D \u043E\u0439\u043D\u0430\u0439\u0434\u044B."
    m_Metadata:
      m_Items: []
