  - m_Id: 2373931010
    m_Localized: "<color=#74E5D0>02  /  \u0416\u0410\u049A\u042B\u041D \u0428\u0410\u0419\u049A\u0410\u0421</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931011
    m_Localized: "<color=#74E5D0>03  /  \u0411\u0410\u049A\u042B\u041B\u0410\u0423</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931012
    m_Localized: "\u0422\u0430\u0431\u0430\u043D\u0434\u044B\u043B\u044B\u049B\n\u0414\u0435\u043D\u0441\u0430\u0443\u043B\u044B\u049B \u0430\u0437\u0430\u0439\u0493\u0430\u043D\u0434\u0430 \u0437\u0430\u043B\u0430\u043B \u043A\u0435\u043C\u0438\u0434\u0456\n\n\u049A\u0430\u0439\u0442\u0430 \u043E\u0440\u0430\u043B\u0443 \xB7 Q\n\u04E8\u043B\u0456\u043C \u0441\u043E\u049B\u049B\u044B\u0441\u044B\u043D\u0430\u043D \u049B\u043E\u0440\u0493\u0430\u0439\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931013
    m_Localized: "\u041E\u043D\u0438 \u049B\u0430\u043D\u044B\n\u0414\u0435\u043D\u0441\u0430\u0443\u043B\u044B\u049B \u0430\u0437\u0430\u0439\u0493\u0430\u043D\u0434\u0430 \u0442\u04E9\u0437\u0456\u043C\u0434\u0456\u043B\u0456\u043A \u0430\u0440\u0442\u0430\u0434\u044B\n\n\u041E\u043D\u0438 \u043A\u0435\u0439\u043F\u0456 \xB7 Q\n40 \u0441\u0435\u043A\u0443\u043D\u0434\u049B\u0430 \u043C\u04AF\u0439\u0456\u0437 \u0431\u0435\u043D \u0448\u043E\u049B\u043F\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931014
    m_Localized: "\u0428\u0435\u043A\u0441\u0456\u0437\u0434\u0456\u043A\n\u0421\u043E\u049B\u049B\u044B\u043D\u044B \u043C\u0435\u0437\u0433\u0456\u043B-\u043C\u0435\u0437\u0433\u0456\u043B \u0431\u04E9\u0433\u0435\u0439\u0434\u0456\n\n\u041A\u04AF\u043B\u0433\u0456\u043D \xB7 Q\n\u0410\u043B\u044B\u0441\u049B\u0430 \u04B1\u0448\u0430\u0442\u044B\u043D \u0442\u0435\u0441\u0456\u043F \u04E9\u0442\u0443\u0448\u0456 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931015
    m_Localized: "\u0416\u041E\u0420\u042B\u049A\u0422\u042B \u0411\u0410\u0421\u0422\u0410\u0423   \u2192"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931016
    m_Localized: "\u0416\u0415\u041A\u0415 \u041E\u0419\u042B\u041D\n\u0422\u0430\u04A3\u0434\u0430\u0443: \u0442\u0456\u043D\u0442\u0443\u0456\u0440 \u043D\u0435\u043C\u0435\u0441\u0435 1\u20133 \xB7 \u0411\u0430\u0441\u0442\u0430\u0443: Enter"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931017
    m_Localized: "\u0416\u0415\u041A\u0415 \u041E\u0419\u042B\u041D\n\u0422\u0430\u04A3\u0434\u0430\u0443: \u0442\u0456\u043D\u0442\u0443\u0456\u0440 \u043D\u0435\u043C\u0435\u0441\u0435 1\u20134 \xB7 \u0411\u0430\u0441\u0442\u0430\u0443: Enter"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931018
    m_Localized: "\u0411\u0406\u0420\u041B\u0415\u0421\u041A\u0415\u041D \u041E\u0419\u042B\u041D"
    m_Metadata:
      m_Items: []
