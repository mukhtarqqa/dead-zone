  - m_Id: 2373931020
    m_Localized: "\u0411\u0430\u043F\u0442\u0430\u0443\u043B\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931021
    m_Localized: "\u0414\u044B\u0431\u044B\u0441 \u04D9\u0441\u0435\u0440\u043B\u0435\u0440\u0456\u043D\u0456\u04A3 \u0434\u0435\u04A3\u0433\u0435\u0439\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931022
    m_Localized: "\u041C\u0443\u0437\u044B\u043A\u0430 \u0434\u0435\u04A3\u0433\u0435\u0439\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931023
    m_Localized: "\u0416\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931024
    m_Localized: "\u041C\u04D9\u0437\u0456\u0440\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931025
    m_Localized: "\u041E\u0439\u044B\u043D\u043D\u0430\u043D \u0448\u044B\u0493\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931026
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430 \u0434\u0456\u0440\u0456\u043B\u0456: \u049A\u041E\u0421\u0423\u041B\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931027
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430 \u0434\u0456\u0440\u0456\u043B\u0456: \u04E8\u0428\u0406\u0420\u0423\u041B\u0406"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931028
    m_Localized: "Esc \u2014 \u0436\u0430\u0431\u0443 \xB7 \u0411\u0456\u0440\u043B\u0435\u0441\u043A\u0435\u043D \u043E\u0439\u044B\u043D\u0434\u0430 \u0448\u0430\u0439\u049B\u0430\u0441 \u0436\u0430\u043B\u0493\u0430\u0441\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931029
    m_Localized: "\u04AE\u0417\u0406\u041B\u0406\u0421\n\nEsc \u2014 \u0436\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931030
    m_Localized: "\u0421\u0406\u0417 \u049A\u0410\u0417\u0410 \u0422\u0410\u041F\u0422\u042B\u04A2\u042B\u0417\n\u041A\u0435\u043B\u0435\u0441\u0456 \u0442\u043E\u043B\u049B\u044B\u043D\u043D\u044B\u04A3 \u0431\u0430\u0441\u044B\u043D\u0434\u0430 \u049B\u0430\u0439\u0442\u0430 \u0442\u0456\u0440\u0456\u043B\u0435\u0441\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931031
    m_Localized: "\u0421\u0406\u0417 \u0416\u0410\u0420\u0410\u041B\u0410\u041D\u0414\u042B\u04A2\u042B\u0417\n\u041E\u0434\u0430\u049B\u0442\u0430\u0441 E \u043F\u0435\u0440\u043D\u0435\u0441\u0456\u043C\u0435\u043D \u0442\u04B1\u0440\u0493\u044B\u0437\u0430 \u0430\u043B\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125312
    m_Localized: "WASD \u049B\u043E\u0437\u0493\u0430\u043B\u0443   \u041B\u041A\u041C \u0430\u0442\u0443   R \u043E\u049B\u0442\u0430\u0443   SHIFT \u0441\u0435\u0440\u043F\u0456\u043B\u0443   Q \u049B\u0430\u0431\u0456\u043B\u0435\u0442   E \u0430\u043B\u0443   TAB \u049B\u0430\u0440\u0443   G \u0433\u0440\u0430\u043D\u0430\u0442\u0430   F \u043C\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125313
    m_Localized: "<color=#FF75BC>\u041E\u041D\u0418 \u0428\u041E\u049A\u041F\u0410\u0420\u042B \xB7 {0} \u0441</color>"
    m_Metadata:
