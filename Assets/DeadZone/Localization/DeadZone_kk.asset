    m_Localized: "\u0422\u043E\u043B\u049B\u044B\u043D \u0430\u044F\u049B\u0442\u0430\u043B\u0434\u044B \xB7 \u049B\u043E\u0440 \u0436\u0438\u043D\u0430"
