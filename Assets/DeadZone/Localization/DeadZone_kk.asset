  - m_Id: 45625995382786
    m_Localized: "WASD \u2014 \u049B\u043E\u0437\u0493\u0430\u043B\u0443\n\u0422\u0456\u043D\u0442\u0443\u0456\u0440 \u2014 \u043A\u04E9\u0437\u0434\u0435\u0443 \xB7 \u041B\u041A\u041C \u2014 \u0430\u0442\u0443\nR \u2014 \u049B\u0430\u0439\u0442\u0430 \u043E\u049B\u0442\u0430\u0443 \xB7 Tab \u2014 \u049B\u0430\u0440\u0443 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0443\nShift \u2014 \u049B\u044B\u0441\u049B\u0430 \u049B\u043E\u0440\u0493\u0430\u043D\u044B\u0441\u043F\u0435\u043D \u0441\u0435\u0440\u043F\u0456\u043B\u0443\nQ \u2014 \u0431\u0435\u043B\u0441\u0435\u043D\u0434\u0456 \u049B\u0430\u0431\u0456\u043B\u0435\u0442\nG \u2014 \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \xB7 F \u2014 \u043C\u0438\u043D\u0430\nE \u2014 \u0437\u0430\u0442\u0442\u044B \u0430\u043B\u0443 / \u0436\u0430\u0441\u044B\u0440\u044B\u043D \u049B\u043E\u0440\u0434\u044B \u0430\u0448\u0443\nE-\u043D\u0456 \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u0443 \u2014 \u043E\u0434\u0430\u049B\u0442\u0430\u0441\u0442\u044B \u0442\u04B1\u0440\u0493\u044B\u0437\u0443\n\n\u049A\u0430\u0440\u0443: \u0435\u043A\u0456 \u04B1\u044F, \u049B\u043E\u043B\u0434\u0430\u0493\u044B \u049B\u0430\u0440\u0443 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u043B\u0430\u0434\u044B.\n\u049A\u0430\u0431\u0456\u043B\u0435\u0442 \u0437\u0430\u049B\u044B\u043C \u043A\u0435\u043B\u0442\u0456\u0440\u0443 \u0436\u04D9\u043D\u0435 \u0436\u0430\u0443\u0434\u044B \u0436\u043E\u044E \u0430\u0440\u049B\u044B\u043B\u044B \u0442\u043E\u043B\u0430\u0434\u044B."
