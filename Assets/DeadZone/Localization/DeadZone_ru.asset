    m_Localized: "\n\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C: {0}%   \u0413\u0440\u0430\u043D\u0430\u0442\u044B: {1}   \u041C\u0438\u043D\u044B: {2}"
