      m_Items: []
  - m_Id: 2378125345
    m_Localized: "\u041D\u0410\u0411\u041B\u042E\u0414\u0410\u0415\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125346
    m_Localized: "\u041F\u041E\u0414\u041D\u042F\u0422\u042C \xB7 {0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125347
    m_Localized: "\u0421\u0422\u0410\u0422\u0418\u0421\u0422\u0418\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125348
    m_Localized: "\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125349
    m_Localized: "\u041C\u0430\u0442\u0447\u0438: {0}\n\u041F\u043E\u0431\u0435\u0434\u044B: {1}\n\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0430: {2}\n\u0423\u0440\u043E\u043D: {3}\n\u041F\u043E\u0434\u043D\u044F\u0442\u043E \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432: {4}\n\u0412\u0440\u0435\u043C\u044F \u0432 \u0438\u0433\u0440\u0435: {5} \u043C\u0438\u043D\n\u041B\u0443\u0447\u0448\u0435\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435: {6}"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125350
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125351
    m_Localized: "DEAD ZONE <color=#74E5D0>/ \u041A\u041E\u041C\u0410\u041D\u0414\u0410</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125352
    m_Localized: "\u041E\u0434\u0438\u043D \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043A\u043E\u043C\u043D\u0430\u0442\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u044E\u0442\u0441\u044F. \u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0433\u0440\u0430\u0435\u0442 \u0441\u0432\u043E\u0438\u043C \u0433\u0435\u0440\u043E\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2378125353
    m_Localized: "\u041B\u041E\u041A\u0410\u041B\u042C\u041D\u0410\u042F \u0421\u0415\u0422\u042C"
    m_Metadata:
      m_Items: []
