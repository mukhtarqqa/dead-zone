    m_Localized: "{0} \xB7 \u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0430 {1} \xB7 \u0423\u0440\u043E\u043D {2} \xB7 \u041F\u043E\u0434\u043D\u044F\u0442\u043E {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125330
    m_Localized: "\u0420\u0415\u041C \xB7 \u041E\u041D\u0418 {0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125331
    m_Localized: "\u041F\u041E\u0414\u0413\u041E\u0422\u041E\u0412\u041A\u0410 \u0421\u041F\u041E\u0421\u041E\u0411\u041D\u041E\u0421\u0422\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125332
    m_Localized: "Q \xB7 \u0421\u041F\u041E\u0421\u041E\u0411\u041D\u041E\u0421\u0422\u042C \u0413\u041E\u0422\u041E\u0412\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125333
    m_Localized: "Q \xB7 \u0417\u0410\u0420\u042F\u0414 {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125334
    m_Localized: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125335
    m_Localized: "\u041F\u0443\u043B\u0435\u043C\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125336
    m_Localized: "\u0414\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125337
    m_Localized: "\u041C\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125338
    m_Localized: "\u041F\u0440\u0438\u043F\u0430\u0441\u044B: \u043F\u0430\u0442\u0440\u043E\u043D\u044B \u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125339
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125340
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125341
    m_Localized: "\u0420\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125342
    m_Localized: "\u041F\u0440\u0438\u0437\u044B\u0432\u0430\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2378125343
    m_Localized: "\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0437\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
