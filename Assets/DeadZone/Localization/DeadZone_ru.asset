    m_Metadata:
      m_Items: []
  - m_Id: 2373931012
    m_Localized: "\u0423\u043F\u043E\u0440\u0441\u0442\u0432\u043E\n\u041C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u043F\u0440\u0438 \u043D\u0438\u0437\u043A\u043E\u043C HP\n\n\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \xB7 Q\n\u0421\u0442\u0440\u0430\u0445\u043E\u0432\u043A\u0430 \u043E\u0442 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931013
    m_Localized: "\u041A\u0440\u043E\u0432\u044C \u043E\u043D\u0438\n\u0412\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C \u043F\u0440\u0438 \u043D\u0438\u0437\u043A\u043E\u043C HP\n\n\u0424\u043E\u0440\u043C\u0430 \u043E\u043D\u0438 \xB7 Q\n\u0420\u043E\u0433 \u0438 \u0431\u0443\u043B\u0430\u0432\u0430 \u043D\u0430 40 \u0441\u0435\u043A\u0443\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931014
    m_Localized: "\u0411\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044C\n\u041F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0430 \u0443\u0434\u0430\u0440\u0430\n\n\u0424\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439 \xB7 Q\n\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2373931015
    m_Localized: "\u041D\u0410\u0427\u0410\u0422\u042C \u0412\u042B\u041B\u0410\u0417\u041A\u0423   \u2192"
    m_Metadata:
      m_Items: []
