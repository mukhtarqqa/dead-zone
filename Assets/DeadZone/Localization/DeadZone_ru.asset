    m_Localized: "Esc \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \xB7 \u0412 \u043A\u043E\u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u0435 \u0431\u043E\u0439 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F"
