    m_Localized: "\u041E\u0414\u0418\u041D\u041E\u0427\u041D\u042B\u0419 \u0420\u0415\u0416\u0418\u041C\n\u0412\u044B\u0431\u043E\u0440: \u043C\u044B\u0448\u044C \u0438\u043B\u0438 1\u20134 \xB7 \u0421\u0442\u0430\u0440\u0442: Enter"
